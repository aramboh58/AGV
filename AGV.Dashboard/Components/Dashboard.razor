    private static string NodeShort(NodeRefDto n)
        => string.IsNullOrWhiteSpace(n.Name) ? n.NodeId.ToString() : n.Name!;

    private static string NodeText(NodeRefDto n)
        => string.IsNullOrWhiteSpace(n.Name)
            ? n.NodeId.ToString()
            : $"{n.Name} ({n.NodeId})";

    private static string WaitText(NodeRefDto n)
        => n.HeldByVehicleId is int holder
            ? $"{NodeText(n)} · held by F{holder:D2}"
            : NodeText(n);

