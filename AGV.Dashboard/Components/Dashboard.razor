    // ----------------------------------------------------------------
    // State
    //
    // ARCHITECTURE NOTE: this component previously opened its own
    // separate SignalR HubConnection back to this same server's own
    // /fleethub endpoint (a server-to-server loopback) purely to
    // receive updates DashboardBroadcaster was already raising
    // in-process. That loopback connection was found to be the root
    // cause of severe, erratic delays (seconds to several minutes) in
    // the vehicle-click-to-popup path — see ToDo7.md #10. It has been
    // removed entirely; this component now subscribes directly to
    // DashboardBroadcaster's C# events instead (see OnInitializedAsync
    // and the Handle*/Dispose region below). The real /fleethub hub
    // still exists and works normally for any genuine external client.
    // ----------------------------------------------------------------

    private bool _hubConnected;

    private int _enqueued;
    private int _dispatched;
    private int _completed;
    private int _queueDepth;

    private readonly Dictionary<int, VehicleDisplayState> _vehicleStates = new();

    private string _simTime = "00:00:00";
    private decimal _speedFactor = 60m;

    private VehicleDetailDto? _selectedVehicle;

    // #11b (9/28): the selected vehicle used to be ONE process-wide value
    // on DashboardBroadcaster, so a click in any browser changed the popup
    // in every connected browser. Selection is now per-circuit: this
    // instance owns its own popup and refresh loop. Nothing is shared.
    private System.Threading.CancellationTokenSource? _popupCts;
    private DotNetObjectReference<Dashboard>? _dotNetRef;

    private readonly List<AlertUpdate> _alerts = new();

    // Unique ID per Dashboard component instance (9/9 diagnostic
    // session) — lets us tell distinct instances apart in the server
    // log across refreshes, to verify empirically whether DisposeAsync
    // fires reliably on hard refresh/abrupt navigation. See
    // ToDo14.md #11 for the theory this is testing: an orphaned
    // instance that never disposes stays subscribed to
    // DashboardBroadcaster's events forever, consuming resources in
    // the background indefinitely.
    private readonly string _instanceId = Guid.NewGuid().ToString("N")[..8];

    // ----------------------------------------------------------------
    // Lifecycle
    // ----------------------------------------------------------------

    protected override Task OnInitializedAsync()
    {
        Logger.LogInformation("Dashboard OnInitializedAsync: instance {InstanceId} STARTING", _instanceId);

        // Seed vehicle states from registry so cards appear immediately
        foreach (var vehicle in VehicleRegistry.GetAll())
        {
            _vehicleStates[vehicle.VehicleId] = new VehicleDisplayState
            {
                VehicleId = vehicle.VehicleId,
                SerialNumber = vehicle.SerialNumber,
                ActivityState = "Idle",
                SocPercent = vehicle.BatteryStateOfCharge,
            };
        }

        // Subscribe directly to the broadcaster's in-process events —
        // no network hop, no serialization, no separate connection
        // lifecycle to manage or lose. Unsubscription is handled by
        // UnsubscribeFromBroadcaster (see below), called from BOTH
        // DisposeAsync (for graceful teardown) AND CircuitCleanup's
        // registered callback (the RELIABLE path — see 9/10 note above
        // and CircuitCleanupRegistry's own doc comments; DisposeAsync
        // alone was confirmed NOT to fire on a hard refresh).
        Broadcaster.VehicleStatesUpdated += HandleVehicleStatesUpdated;
        Broadcaster.VehiclePositionsUpdated += HandleVehiclePositionsUpdated;
        Broadcaster.MissionCountersUpdated += HandleMissionCountersUpdated;
        Broadcaster.SimClockUpdated += HandleSimClockUpdated;
        Broadcaster.AlertsUpdated += HandleAlertsUpdated;
        Broadcaster.VehicleMissionUpdated += HandleVehicleMissionUpdated;

        CircuitCleanup.RegisterCleanup(UnsubscribeFromBroadcaster);

        // No separate connection to track anymore — the Blazor circuit
        // itself (managed by the framework, with its own "Could not
        // reconnect" overlay on genuine loss) is the only connectivity
        // that matters now. Simply reflect that this component is up.
        _hubConnected = true;

        return Task.CompletedTask;
    }

    private bool _mapInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("fleetMap.init");
            await JS.InvokeVoidAsync("fleetMap.setDotNetRef", _dotNetRef);
            _mapInitialized = true;
        }
    }

    // ----------------------------------------------------------------
    // Event handlers — each of these is invoked by DashboardBroadcaster
    // from one of its background broadcast-loop threads, NOT the Blazor
    // render thread, so every handler marshals its work back via
    // InvokeAsync (which also lets us safely await JS interop calls,
    // replacing the previous fire-and-forget Task.Run(() => JS...)
    // pattern with a properly dispatched await).
    //
    // NOTE (9/10 diagnostic session): all InvokeAsync calls below are
    // fire-and-forget — none of them are awaited or otherwise observed
    // by the caller. If InvokeAsync (or the work inside it) throws for
    // ANY reason, that exception was previously silently swallowed as
    // an unobserved Task exception, with nothing logged anywhere. This
    // is the leading theory for a discovered bug where a circuit's
    // continuous rendering (map/sim-clock/fleet-grid updates) silently
    // and permanently stopped functioning while that same circuit's
    // click-handling kept working perfectly — see ToDo15.md #11.
    // SafeInvokeAsync below observes and logs any such exception, so
    // if this happens again, the server log will show exactly which
    // handler failed and why, instead of silence.
    // ----------------------------------------------------------------

    private void SafeInvokeAsync(Func<Task> work, string handlerName)
    {
        var task = InvokeAsync(work);
        task.ContinueWith(t =>
        {
            Logger.LogError(t.Exception, "Unhandled exception in {Handler}'s InvokeAsync — " +
                "this circuit's continuous rendering may now be silently broken for this " +
                "event going forward. See ToDo15.md #11.", handlerName);
        }, TaskContinuationOptions.OnlyOnFaulted | TaskContinuationOptions.ExecuteSynchronously);
    }

    private void HandleVehicleStatesUpdated(List<VehicleStateDto> batch)
    {
        SafeInvokeAsync(async () =>
        {
            foreach (var state in batch)
            {
                _vehicleStates[state.VehicleId] = new VehicleDisplayState
                {
                    VehicleId = state.VehicleId,
                    SerialNumber = state.SerialNumber,
                    ActivityState = state.ActivityState,
                    SocPercent = state.SocPercent,
                    IsCharging = state.IsCharging,
                    IsLoaded = state.IsLoaded,
                    VehicleType = state.VehicleType,
                };
            }
            await JS.InvokeVoidAsync("fleetMap.updateStates", batch);
            StateHasChanged();
        }, nameof(HandleVehicleStatesUpdated));
    }

    private void HandleVehiclePositionsUpdated(List<VehiclePositionDto> batch)
    {
        SafeInvokeAsync(async () =>
        {
            await JS.InvokeVoidAsync("fleetMap.updatePositions", batch);
        }, nameof(HandleVehiclePositionsUpdated));
    }

    private void HandleMissionCountersUpdated(MissionCounterUpdate counters)
    {
        SafeInvokeAsync(() =>
        {
            _enqueued = counters.Enqueued;
            _dispatched = counters.Dispatched;
            _completed = counters.Completed;
            _queueDepth = counters.QueueDepth;
            StateHasChanged();
            return Task.CompletedTask;
        }, nameof(HandleMissionCountersUpdated));
    }

    private void HandleSimClockUpdated(SimClockUpdate clock)
    {
        SafeInvokeAsync(() =>
        {
            _simTime = clock.SimTime;
            _speedFactor = clock.SpeedFactor;
            StateHasChanged();
            return Task.CompletedTask;
        }, nameof(HandleSimClockUpdated));
    }

    private void HandleAlertsUpdated(List<AlertUpdate> batch)
    {
        SafeInvokeAsync(() =>
        {
            _alerts.Clear();
            _alerts.AddRange(batch);
            StateHasChanged();
            return Task.CompletedTask;
        }, nameof(HandleAlertsUpdated));
    }

    private void HandleVehicleMissionUpdated(
        int vehicleId, int? missionId, IReadOnlyList<int> routeNodeIds)
    {
        SafeInvokeAsync(async () =>
        {
            await JS.InvokeVoidAsync(
                "fleetMap.setVehicleRoute", vehicleId, routeNodeIds.ToArray());
        }, nameof(HandleVehicleMissionUpdated));
    }

