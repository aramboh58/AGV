@page "/"
@using AGV.Core.Enums
@using AGV.Core.Messages
@using AGV.Fleet.Infrastructure
@using AGV.Dashboard.Services
@using Microsoft.JSInterop
@inject NavigationManager Nav
@inject VehicleRegistry VehicleRegistry
@inject DashboardBroadcaster Broadcaster
@inject MissionBoardService MissionBoard
@inject ScenarioService Scenarios
@inject IJSRuntime JS
@inject ILogger<Dashboard> Logger
@inject CircuitCleanupRegistry CircuitCleanup
@implements IAsyncDisposable

<div class="dashboard">

    <!-- ── Header ─────────────────────────────────────────────── -->
    <header class="dash-header">
        <div class="dash-title">
            <span class="dash-title-main">AGV FLEET CONTROL</span>
            <span class="dash-title-sub">New York Times · College Point Production Plant</span>
        </div>
        <div class="dash-header-stats">
            <div class="stat-chip">
                <span class="stat-label">SIM TIME</span>
                <span class="stat-value mono">@_simTime</span>
            </div>
            <div class="stat-chip">
                <span class="stat-label">SPEED</span>
                <span class="stat-value mono">@_speedFactor×</span>
            </div>
            <div class="stat-chip @(_hubConnected ? "online" : "offline")">
                <span class="stat-dot"></span>
                <span class="stat-label">@(_hubConnected ? "LIVE" : "CONNECTING")</span>
            </div>
        </div>
    </header>

    <!-- ── Body ───────────────────────────────────────────────── -->
    <div class="dash-body">

        <!-- ── Floor Map ──────────────────────────────────────── -->
        <section class="map-panel">
            <div class="panel-label">FLOOR MAP — NYT COLLEGE POINT</div>
            <div class="map-controls">
                <button class="map-btn" onclick="window.fleetMap.zoomIn()">+</button>
                <button class="map-btn" onclick="window.fleetMap.zoomOut()">−</button>
                <button class="map-btn" onclick="window.fleetMap.resetView()">⌂</button>
            </div>
            <div class="map-container" id="map-container-placeholder"></div>
            
        </section>

        <!-- ── Right Panel ────────────────────────────────────── -->
        <aside class="right-panel">

            <!-- Mission Counters -->
            <section class="counter-panel">
                <div class="panel-label panel-label-row">
                    <span>MISSIONS</span>
                    <span class="label-btns">
                        <button class="scenario-btn @(_scOpen ? "queue-btn-on" : "")" data-sc="toggle">SIM</button>
                        <button class="builder-btn @(_builderOpen ? "queue-btn-on" : "")">NEW</button>
                        <button class="queue-btn @(_boardOpen ? "queue-btn-on" : "")">QUEUE</button>
                    </span>
                </div>
                <div class="counters">
                    <div class="counter">
                        <span class="counter-value" id="cnt-enqueued">@_enqueued</span>
                        <span class="counter-label">ENQUEUED</span>
                        <span class="counter-sublabel">▸ @_queueDepth in queue</span>
                    </div>
                    <div class="counter">
                        <span class="counter-value" id="cnt-dispatched">@_dispatched</span>
                        <span class="counter-label">DISPATCHED</span>
                    </div>
                    <div class="counter accent">
                        <span class="counter-value" id="cnt-completed">@_completed</span>
                        <span class="counter-label">COMPLETED</span>
                    </div>
                </div>
            </section>

            <!-- Vehicle Status Grid -->
            <section class="vehicle-panel">
                <div class="panel-label">FLEET STATUS — 20 VEHICLES</div>
                <div class="vehicle-grid">
                    @foreach (var v in _vehicleStates.Values.OrderBy(v => v.VehicleId))
                    {
                        <div class="vehicle-card @GetStateClass(v.ActivityState)">
                            <div class="vc-id">F@(v.VehicleId.ToString("D2"))</div>
                            <div class="vc-state">@GetStateAbbrev(v.ActivityState)</div>
                            <div class="vc-soc">
                                <div class="soc-bar">
                                    <div class="soc-fill @GetSocClass(v.SocPercent)"
                                         style="width: @((int)v.SocPercent)%"></div>
                                </div>
                                <span class="soc-label">@((int)v.SocPercent)%</span>
                            </div>
                        </div>
                    }
                </div>
            </section>

            @if (_alerts.Count > 0)
            {
                <section class="alert-panel">
                    <div class="panel-label">ALERTS</div>
                    @foreach (var a in _alerts.OrderByDescending(x => x.Timestamp))
                    {
                        <div class="alert-row @GetAlertClass(a.Type)">
                            <span class="alert-icon">@GetAlertIcon(a.Type)</span>
                            <span class="alert-msg">@a.Message</span>
                        </div>
                    }
                </section>
            }
        </aside>

        @if (_selectedVehicle is not null)
        {
            <div class="vehicle-popup">
                <button class="popup-close">✕</button>

                <div class="popup-title">F@(_selectedVehicle.VehicleId.ToString("D2"))</div>
                <div class="popup-row">
                    <span class="popup-label">STATE</span>
                    <span class="popup-value">@_selectedVehicle.ActivityState</span>
                </div>
                <div class="popup-row">
                    <span class="popup-label">SOC</span>
                    <span class="popup-value">@_selectedVehicle.SocPercent.ToString("F0")%</span>
                </div>
                <div class="popup-row">
                    <span class="popup-label">MISSION</span>
                    <span class="popup-value">@(_selectedVehicle.CurrentMissionId?.ToString() ?? "—")</span>
                </div>
                @if (_selectedVehicle.CurrentPart is not null)
                {
                    <div class="popup-row">
                        <span class="popup-label">CURRENT</span>
                        <span class="popup-value popup-part">@PartText(_selectedVehicle.CurrentPart)</span>
                    </div>
                }
                @if (_selectedVehicle.NextPart is not null)
                {
                    <div class="popup-row">
                        <span class="popup-label">NEXT</span>
                        <span class="popup-value popup-part">@PartText(_selectedVehicle.NextPart)</span>
                    </div>
                }
                <div class="popup-section-label">SOC HISTORY</div>
                <div class="popup-chart">
                    @{
                        var max = 100.0;
                        var min = 0.0;
                        var range = 100.0;
                    }
                    <svg class="soc-sparkline" viewBox="0 0 150 40" preserveAspectRatio="none">
                        @if (_selectedVehicle.SocHistory.Count > 1)
                        {
                            var points = _selectedVehicle.SocHistory
                            .Select((s, i) =>
                            {
                                var x = i * 150.0 / (_selectedVehicle.SocHistory.Count - 1);
                                var y = 40 - ((double)s - min) / range * 35;
                                return $"{x:F1},{y:F1}";
                            });
                            <polyline points="@string.Join(" ", points)"
                                      fill="none" stroke="#06b6d4" stroke-width="1.5" />
                        }
                    </svg>
                </div>
                <div class="popup-section-label">ROUTE</div>
                <div class="popup-route">
                    @foreach (var nodeId in _selectedVehicle.RouteNodeIds)
                    {
                        <span class="route-node @(nodeId == _selectedVehicle.CurrentNodeId ? "route-node-current" : "")">
                            @nodeId
                        </span>
                    }
                </div>

                <div class="popup-section-label">LOCKED NODES</div>
                <div class="popup-route">
                    @if (_selectedVehicle.LockedNodes.Count == 0)
                    {
                        <span class="popup-empty">—</span>
                    }
                    @foreach (var n in _selectedVehicle.LockedNodes)
                    {
                        <span class="route-node" title="@n.NodeId">@NodeText(n)</span>
                    }
                </div>

                <div class="popup-section-label">LOCKED MOVES</div>
                <div class="popup-route">
                    @if (_selectedVehicle.LockedMoves.Count == 0)
                    {
                        <span class="popup-empty">—</span>
                    }
                    @foreach (var m in _selectedVehicle.LockedMoves)
                    {
                        <span class="route-node" title="Move @m.MoveId">@NodeShort(m.From) → @NodeShort(m.To)</span>
                    }
                </div>

                <div class="popup-section-label">WAITING ON</div>
                <div class="popup-route">
                    @if (_selectedVehicle.WaitedNodes.Count == 0)
                    {
                        <span class="popup-empty">—</span>
                    }
                    @foreach (var n in _selectedVehicle.WaitedNodes)
                    {
                        <span class="route-node route-node-wait" title="@n.NodeId">@WaitText(n)</span>
                    }
                </div>
            </div>
        }


        @if (_scOpen && _builderOptions is not null)
        {
            var showRun = _scRun is not null && _scShowRun;
            <div class="scenario-dialog">
                <button class="builder-close" data-sc="close">✕</button>
                <div class="popup-title">SIMULATION CHOREOGRAPHY <span class="sc-tag">SIMULATION / DEMO ONLY</span></div>
                <div class="sc-note">T+ is local (wall-clock) time since RUN is pressed.</div>

                <div class="sc-toolbar">
                    <input id="sc-name" class="builder-select sc-name" placeholder="Simulation name" maxlength="64" />
                    <button class="sc-btn" data-sc="save">SAVE</button>
                    <select id="sc-saved" class="builder-select sc-saved">
                        @foreach (var n in _scSaved)
                        {
                            <option value="@n">@n</option>
                        }
                    </select>
                    <button class="sc-btn" data-sc="load">LOAD</button>
                    <button class="sc-btn" data-sc="delete">DELETE</button>
                </div>

                <div class="sc-toolbar">
                    <input id="sc-off" class="builder-select sc-off" placeholder="T+ mm:ss" value="0:00" />
                    <select id="sc-pick" class="builder-select">
                        @foreach (var n in _builderOptions.PickLocations)
                        {
                            <option value="@n">@n</option>
                        }
                    </select>
                    <select id="sc-drop" class="builder-select">
                        @foreach (var n in _builderOptions.DropLocations)
                        {
                            <option value="@n">@n</option>
                        }
                    </select>
                    <select id="sc-pri" class="builder-select sc-pri">
                        @foreach (var p in _builderOptions.Priorities)
                        {
                            <option value="@p" selected="@(p == "Normal")">@p</option>
                        }
                    </select>
                    <button class="sc-btn" data-sc="add">ADD</button>
                </div>

                <div class="sc-toolbar">
                    <button class="sc-btn sc-run" data-sc="run">▶ RUN</button>
                    <button class="sc-btn sc-stop" data-sc="stop">■ STOP</button>
                    <button class="sc-btn" data-sc="clear">CLEAR</button>
                    @if (showRun)
                    {
                        <span class="sc-runline">@_scRun!.Name · started @_scRun.StartedAt · T+ @FormatOffset(_scRun.ElapsedSeconds) · @(_scRun.Running ? "RUNNING" : "COMPLETE")</span>
                    }
                </div>
                <div id="sc-msg" class="builder-msg"></div>

                <div class="sc-gridwrap">
                    <table class="sc-grid">
                        <thead>
                            <tr><th>#</th><th>T+</th><th>STAGED</th><th>MISSION</th><th>PICK</th><th>DROP</th><th>PRIORITY</th><th>VEHICLE</th><th>STATUS</th><th></th></tr>
                        </thead>
                        <tbody>
                            @if (showRun)
                            {
                                @foreach (var row in _scRun!.Rows)
                                {
                                    <tr>
                                        <td>@(row.Index + 1)</td>
                                        <td>@FormatOffset(row.OffsetSeconds)</td>
                                        <td>@(row.StagedAt ?? "—")</td>
                                        <td>@(row.MissionId is int mid ? $"M{mid}" : "—")</td>
                                        <td>@row.Pick@(row.PickNode is int pn ? $" ({pn})" : "")</td>
                                        <td>@row.Drop@(row.DropNode is int dn ? $" ({dn})" : "")</td>
                                        <td>@row.Priority</td>
                                        <td>@(row.VehicleId is int v ? $"F{v:D2}" : "—")</td>
                                        <td class="sc-status-@row.Status.ToLowerInvariant()">@row.Status</td>
                                        <td></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                @for (var i = 0; i < _scDraft.Count; i++)
                                {
                                    var m = _scDraft[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>@FormatOffset(m.OffsetSeconds)</td>
                                        <td>—</td>
                                        <td>—</td>
                                        <td>@m.PickLocation</td>
                                        <td>@m.DropLocation</td>
                                        <td>@m.Priority</td>
                                        <td>—</td>
                                        <td class="sc-status-pending">Draft</td>
                                        <td><button class="board-cancel" data-sc="remove" data-idx="@i" title="Remove">✕</button></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (_builderOpen && _builderOptions is not null)
        {
            <div class="mission-builder">
                <button class="builder-close">✕</button>
                <div class="popup-title">NEW MISSION</div>

                <div class="popup-section-label">PICK AT</div>
                <select id="mb-pick" class="builder-select">
                    @foreach (var n in _builderOptions.PickLocations)
                    {
                        <option value="@n">@n</option>
                    }
                </select>

                <div class="popup-section-label">DROP AT</div>
                <select id="mb-drop" class="builder-select">
                    @foreach (var n in _builderOptions.DropLocations)
                    {
                        <option value="@n">@n</option>
                    }
                </select>

                <div class="popup-section-label">PRIORITY</div>
                <select id="mb-pri" class="builder-select">
                    @foreach (var p in _builderOptions.Priorities)
                    {
                        <option value="@p" selected="@(p == "Normal")">@p</option>
                    }
                </select>

                <button class="builder-submit">ENQUEUE</button>
                <div id="mb-msg" class="builder-msg"></div>
            </div>
        }

        @if (_boardOpen && _board is not null)
        {
            <div class="mission-board">
                <button class="board-close">✕</button>
                <div class="popup-title">MISSION QUEUE</div>

                <div class="popup-section-label">ACTIVE — @_board.Active.Count</div>
                @if (_board.Active.Count == 0)
                {
                    <span class="popup-empty">—</span>
                }
                @foreach (var row in _board.Active)
                {
                    <div class="board-row">
                        <div class="board-row-head">
                            <span class="board-id">M@(row.MissionId)</span>
                            <span class="board-veh">F@(row.VehicleId?.ToString("D2"))</span>
                            <span class="board-state">@row.VehicleState</span>
                            <span class="board-pri">@row.Priority</span>
                            <span class="board-age">@FormatAge(row.AgeSeconds)</span>
                        </div>
                        <div class="board-parts">
                            @for (var i = 0; i < row.Parts.Count; i++)
                            {
                                <span class="route-node @(i == row.CurrentIndex ? "route-node-current" : "")">@row.Parts[i].Operation · @row.Parts[i].Label</span>
                            }
                        </div>
                    </div>
                }

                <div class="popup-section-label">QUEUED — @_board.QueuedTotal@(_board.QueuedTotal > _board.Queued.Count ? $" (showing {_board.Queued.Count})" : "")</div>
                @if (_board.Queued.Count == 0)
                {
                    <span class="popup-empty">—</span>
                }
                @foreach (var row in _board.Queued)
                {
                    <div class="board-row">
                        <div class="board-row-head">
                            <span class="board-id">M@(row.MissionId)</span>
                            <span class="board-pri">@row.Priority</span>
                            <span class="board-age">@FormatAge(row.AgeSeconds)</span>
                            <button class="board-cancel" title="Cancel mission" data-mid="@row.MissionId">✕</button>
                        </div>
                        <div class="board-parts">
                            @foreach (var p in row.Parts)
                            {
                                <span class="route-node">@p.Operation · @p.Label</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    // ----------------------------------------------------------------
    // Simulation choreography (SIMULATION / DEMO ONLY). The draft lives in
    // this circuit; playback lives in ScenarioService. Controls are plain
    // HTML wired by fleet-map.js ([data-sc] buttons -> ScenarioActionJs).
    // ----------------------------------------------------------------
    private bool _scOpen;
    private bool _scShowRun;
    private readonly List<ScenarioMissionDef> _scDraft = new();
    private List<string> _scSaved = new();
    private ScenarioRunDto? _scRun;
    private System.Threading.CancellationTokenSource? _scCts;

    private static string FormatOffset(int seconds)
        => seconds >= 3600
            ? $"{seconds / 3600}:{seconds % 3600 / 60:D2}:{seconds % 60:D2}"
            : $"{seconds / 60}:{seconds % 60:D2}";

    private static bool TryParseOffset(string? text, out int seconds)
    {
        seconds = 0;
        var parts = (text ?? "").Trim().Split(':');
        if (parts.Length is < 1 or > 3) return false;
        var total = 0;
        foreach (var p in parts)
        {
            if (!int.TryParse(p, out var n) || n < 0) return false;
            total = total * 60 + n;
        }
        seconds = total;
        return true;
    }

    [JSInvokable]
    public Task<string> ScenarioActionJs(
        string action, string name, string saved, string offset,
        string pick, string drop, string priority, string idx)
    {
        string msg = "";
        try
        {
            var running = Scenarios.IsRunning;
            switch (action)
            {
                case "toggle":
                    if (_scOpen) CloseScenario(); else OpenScenario();
                    break;
                case "close":
                    CloseScenario();
                    break;
                case "add":
                    if (running) { msg = "Simulation running: stop it first."; break; }
                    if (!TryParseOffset(offset, out var off)) { msg = "T+ must be seconds, mm:ss or h:mm:ss."; break; }
                    _scDraft.Add(new ScenarioMissionDef(off, pick, drop, priority));
                    var sorted = _scDraft.OrderBy(m => m.OffsetSeconds).ToList(); // stable
                    _scDraft.Clear(); _scDraft.AddRange(sorted);
                    _scShowRun = false;
                    msg = $"{_scDraft.Count} mission(s) in draft.";
                    break;
                case "remove":
                    if (running) { msg = "Simulation running: stop it first."; break; }
                    if (int.TryParse(idx, out var i) && i >= 0 && i < _scDraft.Count) _scDraft.RemoveAt(i);
                    break;
                case "clear":
                    if (running) { msg = "Simulation running: stop it first."; break; }
                    _scDraft.Clear(); Scenarios.ClearRun(); _scRun = null; _scShowRun = false;
                    break;
                case "save":
                    if (string.IsNullOrWhiteSpace(ScenarioService.SafeName(name))) { msg = "Enter a simulation name."; break; }
                    if (_scDraft.Count == 0) { msg = "Nothing to save: add missions first."; break; }
                    Scenarios.Save(new ScenarioDefinition(ScenarioService.SafeName(name), _scDraft.ToList()));
                    _scSaved = Scenarios.ListSaved().ToList();
                    msg = $"Saved '{ScenarioService.SafeName(name)}'.";
                    break;
                case "load":
                    if (running) { msg = "Simulation running: stop it first."; break; }
                    var def = Scenarios.Load(saved);
                    if (def is null) { msg = "Pick a saved simulation to load."; break; }
                    _scDraft.Clear(); _scDraft.AddRange(def.Missions);
                    _scShowRun = false;
                    msg = $"Loaded '{def.Name}' ({def.Missions.Count} missions).";
                    break;
                case "delete":
                    msg = Scenarios.Delete(saved) ? $"Deleted '{saved}'." : "Pick a saved simulation to delete.";
                    _scSaved = Scenarios.ListSaved().ToList();
                    break;
                case "run":
                    var runName = ScenarioService.SafeName(name);
                    if (runName.Length == 0) runName = "Unnamed";
                    msg = Scenarios.Run(new ScenarioDefinition(runName, _scDraft.ToList()));
                    _scRun = Scenarios.GetRun();
                    _scShowRun = _scRun is not null;
                    break;
                case "stop":
                    msg = Scenarios.Stop();
                    _scRun = Scenarios.GetRun();
                    break;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ScenarioActionJs {Action} failed", action);
            msg = $"Error: {ex.Message}";
        }
        StateHasChanged();
        return Task.FromResult(msg);
    }

    private void OpenScenario()
    {
        _builderOptions ??= MissionBoard.GetBuilderOptions();
        _scSaved = Scenarios.ListSaved().ToList();
        _scRun = Scenarios.GetRun();
        _scShowRun = _scRun?.Running == true;
        _scOpen = true;
        StopScenarioRefresh();
        var cts = new System.Threading.CancellationTokenSource();
        _scCts = cts;
        _ = RunScenarioRefreshAsync(cts.Token);
    }

    private void CloseScenario()
    {
        StopScenarioRefresh();
        _scOpen = false;
    }

    private void StopScenarioRefresh()
    {
        var cts = System.Threading.Interlocked.Exchange(ref _scCts, null);
        if (cts is null) return;
        try { cts.Cancel(); } catch (ObjectDisposedException) { }
        cts.Dispose();
    }

    private async Task RunScenarioRefreshAsync(System.Threading.CancellationToken ct)
    {
        try
        {
            using var timer = new System.Threading.PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(ct))
            {
                try
                {
                    var snap = Scenarios.GetRun();
                    SafeInvokeAsync(() =>
                    {
                        if (!ct.IsCancellationRequested)
                        {
                            _scRun = snap;
                            StateHasChanged();
                        }
                        return Task.CompletedTask;
                    }, nameof(RunScenarioRefreshAsync));
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    Logger.LogError(ex, "Scenario refresh tick failed");
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    // ----------------------------------------------------------------
    // Mission builder (#3). Controls are plain HTML read by fleet-map.js
    // (Blazor events are not used on this page); only the option lists
    // are rendered here.
    // ----------------------------------------------------------------
    private bool _builderOpen;
    private MissionBuilderOptions? _builderOptions;

    [JSInvokable]
    public Task ToggleBuilderJs()
    {
        _builderOpen = !_builderOpen;
        if (_builderOpen) _builderOptions ??= MissionBoard.GetBuilderOptions();
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task CloseBuilderJs()
    {
        _builderOpen = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task<string> SubmitMissionJs(string pick, string drop, string priority)
        => MissionBoard.CreateMissionAsync(pick, drop, priority);

    // ----------------------------------------------------------------
    // Mission queue viewer (#4). Per-circuit, like the vehicle popup:
    // polls MissionBoardService once a second only while open.
    // ----------------------------------------------------------------
    private bool _boardOpen;
    private MissionBoardDto? _board;
    private System.Threading.CancellationTokenSource? _boardCts;

    private static string FormatAge(int seconds)
        => seconds >= 3600
            ? $"{seconds / 3600}h{seconds % 3600 / 60:D2}m"
            : $"{seconds / 60}:{seconds % 60:D2}";

    // Invoked from fleet-map.js's document click handler (same pattern as
    // OnVehicleClicked / ClosePopup): Blazor @onclick never fired here.
    [JSInvokable]
    public Task ToggleBoardJs() { ToggleBoard(); StateHasChanged(); return Task.CompletedTask; }

    [JSInvokable]
    public Task CloseBoardJs() { CloseBoard(); StateHasChanged(); return Task.CompletedTask; }

    [JSInvokable]
    public Task CancelMissionJs(int missionId) { CancelMission(missionId); StateHasChanged(); return Task.CompletedTask; }

    private void ToggleBoard()
    {
        if (_boardOpen) CloseBoard(); else OpenBoard();
    }

    private void OpenBoard()
    {
        _board = MissionBoard.GetSnapshot();
        _boardOpen = true;
        StopBoardRefresh();
        var cts = new System.Threading.CancellationTokenSource();
        _boardCts = cts;
        _ = RunBoardRefreshAsync(cts.Token);
    }

    private void CloseBoard()
    {
        StopBoardRefresh();
        _boardOpen = false;
        _board = null;
    }

    private void CancelMission(int missionId)
    {
        MissionBoard.Cancel(missionId);
        _board = MissionBoard.GetSnapshot();
    }

    private void StopBoardRefresh()
    {
        var cts = System.Threading.Interlocked.Exchange(ref _boardCts, null);
        if (cts is null) return;
        try { cts.Cancel(); } catch (ObjectDisposedException) { }
        cts.Dispose();
    }

    private async Task RunBoardRefreshAsync(System.Threading.CancellationToken ct)
    {
        try
        {
            using var timer = new System.Threading.PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(ct))
            {
                try
                {
                    var snap = MissionBoard.GetSnapshot();
                    SafeInvokeAsync(() =>
                    {
                        if (!ct.IsCancellationRequested)
                        {
                            _board = snap;
                            StateHasChanged();
                        }
                        return Task.CompletedTask;
                    }, nameof(RunBoardRefreshAsync));
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    Logger.LogError(ex, "Mission board refresh tick failed");
                }
            }
        }
        catch (OperationCanceledException) { /* board closed */ }
    }

